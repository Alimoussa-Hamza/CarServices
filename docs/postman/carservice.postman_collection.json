            "method": "POST",
            "description": "JWT. PUT presignée TTL 15 min (RG photos). Sans S3: mock cdn.carservice.test. booking_photo exige bookingId + photoType.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mimeType\": \"image/jpeg\",\n  \"context\": \"booking_photo\",\n  \"bookingId\": \"{{bookingId}}\",\n  \"photoType\": \"before\"\n}"
            },
            "url": "{{baseUrl}}/media/upload-url"
          }
        },
        {
          "name": "Confirm Upload",
          "request": {
            "method": "POST",
            "description": "JWT. Confirme l’objet (HeadObject S3, skip mock) et attache booking_photos. KYC: pas d’écriture booking_photos.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileKey\": \"bookings/{{bookingId}}/before/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa.jpg\"\n}"
            },
            "url": "{{baseUrl}}/media/confirm"
          }
        }
      ]
