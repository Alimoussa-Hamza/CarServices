{
  "expo": {
    "name": "CarWash",
    "slug": "carservice-client",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "carservice-client",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D6E4F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.carservice.client"
    },
    "android": {
      "package": "fr.carservice.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D6E4F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@stripe/stripe-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
