# API — copy to .env
PORT=3000
NODE_ENV=development

# Docker compose (ports 5434/6380 to avoid conflict with local Postgres/Redis)
DATABASE_URL=postgresql://carservice:carservice@localhost:5434/carservice?schema=public
REDIS_URL=redis://localhost:6380

CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Stripe Connect (test mode — laisser vide pour mock local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Commission plateforme figée au booking (0.20 = 20 %)
PLATFORM_COMMISSION_RATE=0.20

# Matching broadcast (5–10, défaut 8)
MATCHING_BROADCAST_SIZE=8

# Géofence optionnelle à l'arrivée (mètres, RG-BOOK-03)
BOOKING_GEOFENCE_METERS=200

# Matching timeouts T1/T2 (RG-MATCH-04/05)
MATCHING_TIMEOUT_T1_MINUTES=30
MATCHING_TIMEOUT_T2_HOURS=2
MATCHING_UNASSIGNED_LEAD_HOURS=2
MATCHING_RADIUS_EXPAND_FACTOR=2
# MATCHING_WORKER_ENABLED=true

# Annulation RG-CANCEL
CANCEL_FREE_HOURS=24
CANCEL_LATE_HOURS=2
CANCEL_FEE_MID_PERCENT=20
CANCEL_FEE_LATE_PERCENT=50

# SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
OTP_PEPPER=change-me-otp-pepper-min-32-chars

# Seed
SEED_ADMIN_PHONE=+33600000000

# S3 / Object storage (Scaleway Object Storage ou Cloudflare R2)
# Laisser vide = mock local (CS-M07-S01). Jamais coller les clés dans le chat / le repo.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# Expo Push (CS-M09) — laisser vide = mock console local
EXPO_ACCESS_TOKEN=
# NOTIFICATIONS_WORKER_ENABLED=true

# Google Maps (server)
GOOGLE_MAPS_SERVER_KEY=
