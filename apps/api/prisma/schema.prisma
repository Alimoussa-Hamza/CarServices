generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  provider
  admin
}

enum KycStatus {
  draft
  submitted
  approved
  rejected
}

enum WashMethod {
  waterless
  steam
}

enum KycDocumentType {
  rc_pro
  identity
  other
}

enum BookingStatus {
  draft
  payment_authorized
  pending_provider
  accepted
  en_route
  in_progress
  completed
  cancelled_by_client
  cancelled_by_provider
  cancelled_by_admin
  expired
  unassigned
  disputed
}

enum BookingActorType {
  client
  provider
  admin
  system
}

enum BookingPhotoUploader {
  client
  provider
}

enum BookingPhotoType {
  before
  after
  issue
}

enum VehicleType {
  citadine
  berline
  suv
  utilitaire
  moto
}

enum PaymentStatus {
  authorized
  captured
  refunded
  failed
}

enum DisputeOpenedBy {
  client
  provider
}

enum DisputeReason {
  quality
  delay
  damage
  no_show
  other
}

enum DisputeStatus {
  open
  under_review
  resolved_client
  resolved_provider
  resolved_split
  closed
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String   @unique @db.VarChar(20)
  email        String?  @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clientProfile        ClientProfile?
  providerProfile      ProviderProfile?
  refreshTokens        RefreshToken[]
  addresses            Address[]
  verifiedKycDocuments ProviderKycDocument[] @relation("VerifiedKycDocuments")
  pushTokens           PushToken[]

  @@map("users")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]
  disputes Dispute[]

  @@map("client_profiles")
}

model ProviderProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  companyName        String?      @map("company_name") @db.VarChar(255)
  siret              String?      @unique @db.VarChar(14)
  iban               String?      @db.VarChar(34)
  bio                String?
  avatarUrl          String?      @map("avatar_url") @db.VarChar(500)
  kycStatus          KycStatus    @default(draft) @map("kyc_status")
  kycRejectionReason String?      @map("kyc_rejection_reason")
  washMethods        WashMethod[] @default([]) @map("wash_methods")
  ratingAvg          Decimal      @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int          @default(0) @map("rating_count")
  acceptanceRate     Decimal      @default(100) @map("acceptance_rate") @db.Decimal(5, 2)
  stripeAccountId    String?      @unique @map("stripe_account_id") @db.VarChar(255)
  chargesEnabled     Boolean      @default(false) @map("charges_enabled")
  baseAddressId      String?      @map("base_address_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAddress   Address?               @relation("ProviderBaseAddress", fields: [baseAddressId], references: [id], onDelete: SetNull)
  capabilities  ProviderCapability[]
  availability  ProviderAvailability[]
  blockedSlots  ProviderBlockedSlot[]
  providerZones ProviderZone[]
  kycDocuments  ProviderKycDocument[]
  bookings      Booking[]
  broadcasts    BookingBroadcast[]
  reviews       Review[]
  disputes      Dispute[]

  @@map("provider_profiles")
}

model ProviderCapability {
  providerId String  @map("provider_id") @db.Uuid
  offerId    String  @map("offer_id") @db.Uuid
  isActive   Boolean @default(true) @map("is_active")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  offer    ServiceOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([providerId, offerId])
  @@index([offerId])
  @@map("provider_capabilities")
}

model ProviderAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startTime  DateTime @map("start_time") @db.Time(0)
  endTime    DateTime @map("end_time") @db.Time(0)
  isActive   Boolean  @default(true) @map("is_active")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, dayOfWeek])
  @@map("provider_availability")
}

model ProviderBlockedSlot {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")
  reason     String?  @db.VarChar(255)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startAt])
  @@map("provider_blocked_slots")
}

model ProviderKycDocument {
  id         String          @id @default(uuid()) @db.Uuid
  providerId String          @map("provider_id") @db.Uuid
  docType    KycDocumentType @map("doc_type")
  fileUrl    String          @map("file_url") @db.VarChar(500)
  expiresAt  DateTime?       @map("expires_at") @db.Date
  verifiedAt DateTime?       @map("verified_at")
  verifiedBy String?         @map("verified_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  verifiedByAdmin User?           @relation("VerifiedKycDocuments", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([verifiedBy])
  @@map("provider_kyc_documents")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  label        String?  @db.VarChar(100)
  street       String   @db.VarChar(255)
  complement   String?  @db.VarChar(255)
  city         String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(10)
  country      String   @default("FR") @db.Char(2)
  lat          Decimal  @db.Decimal(10, 7)
  lng          Decimal  @db.Decimal(10, 7)
  instructions String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerBaseProfiles ProviderProfile[] @relation("ProviderBaseAddress")

  @@index([userId])
  @@map("addresses")
}

model ServiceZone {
  id                  String                                 @id @default(uuid()) @db.Uuid
  name                String                                 @db.VarChar(100)
  slug                String                                 @unique @db.VarChar(100)
  polygon             Unsupported("geography(Polygon,4326)")
  isActive            Boolean                                @default(false) @map("is_active")
  priceCoefficient    Decimal                                @default(1.00) @map("price_coefficient") @db.Decimal(4, 2)
  minBookingLeadHours Int                                    @default(2) @map("min_booking_lead_hours")
  createdAt           DateTime                               @default(now()) @map("created_at")

  providerZones ProviderZone[]
  zonePricing   ZonePricing[]
  bookings      Booking[]

  @@map("service_zones")
}

model ProviderZone {
  providerId String   @map("provider_id") @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  radiusKm   Decimal? @map("radius_km") @db.Decimal(5, 2)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  zone     ServiceZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([providerId, zoneId])
  @@map("provider_zones")
}

model ServiceCategory {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?
  icon        String? @db.VarChar(100)
  isEnabled   Boolean @default(false) @map("is_enabled")
  sortOrder   Int     @default(0) @map("sort_order")

  offers ServiceOffer[]

  @@map("service_categories")
}

model ServiceOffer {
  id                String  @id @default(uuid()) @db.Uuid
  categoryId        String  @map("category_id") @db.Uuid
  slug              String  @unique @db.VarChar(100)
  name              String  @db.VarChar(150)
  description       String?
  basePriceCents    Int     @map("base_price_cents")
  durationMinutes   Int     @map("duration_minutes")
  formSchema        Json    @map("form_schema")
  checklistTemplate Json    @map("checklist_template")
  isActive          Boolean @default(true) @map("is_active")
  sortOrder         Int     @default(0) @map("sort_order")

  category             ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options              OfferOption[]
  zonePricing          ZonePricing[]
  providerCapabilities ProviderCapability[]
  bookingItems         BookingItem[]

  @@index([categoryId])
  @@map("service_offers")
}

model OfferOption {
  id                   String  @id @default(uuid()) @db.Uuid
  offerId              String  @map("offer_id") @db.Uuid
  slug                 String  @db.VarChar(100)
  name                 String  @db.VarChar(150)
  priceDeltaCents      Int     @default(0) @map("price_delta_cents")
  durationDeltaMinutes Int     @default(0) @map("duration_delta_minutes")
  isActive             Boolean @default(true) @map("is_active")

  offer ServiceOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, slug])
  @@index([offerId])
  @@map("offer_options")
}

model ZonePricing {
  id                 String @id @default(uuid()) @db.Uuid
  zoneId             String @map("zone_id") @db.Uuid
  offerId            String @map("offer_id") @db.Uuid
  priceOverrideCents Int?   @map("price_override_cents")
  vehicleSurcharges  Json   @map("vehicle_surcharges")

  zone  ServiceZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  offer ServiceOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([zoneId, offerId])
  @@index([offerId])
  @@map("zone_pricing")
}

model OutOfZoneLead {
  id          String   @id @default(uuid()) @db.Uuid
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  lat         Decimal  @db.Decimal(10, 7)
  lng         Decimal  @db.Decimal(10, 7)
  addressText String   @map("address_text")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("out_of_zone_leads")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  reference       String        @unique @db.VarChar(20)
  clientId        String        @map("client_id") @db.Uuid
  providerId      String?       @map("provider_id") @db.Uuid
  categorySlug    String        @map("category_slug") @db.VarChar(50)
  status          BookingStatus @default(draft)
  addressSnapshot Json          @map("address_snapshot")
  slotStart       DateTime      @map("slot_start")
  slotEnd         DateTime      @map("slot_end")
  pricingSnapshot Json          @map("pricing_snapshot")
  commissionRate  Decimal       @map("commission_rate") @db.Decimal(4, 2)
  clientComment   String?       @map("client_comment")
  providerNotes   String?       @map("provider_notes")
  zoneId          String        @map("zone_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client   ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  zone     ServiceZone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  items      BookingItem[]
  history    BookingStatusHistory[]
  photos     BookingPhoto[]
  broadcasts BookingBroadcast[]
  payment    Payment?
  review     Review?
  dispute    Dispute?

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([slotStart, zoneId])
  @@map("bookings")
}

model BookingItem {
  id              String      @id @default(uuid()) @db.Uuid
  bookingId       String      @map("booking_id") @db.Uuid
  offerId         String      @map("offer_id") @db.Uuid
  offerName       String      @map("offer_name") @db.VarChar(150)
  vehicleType     VehicleType @map("vehicle_type")
  optionsSnapshot Json        @map("options_snapshot")
  formData        Json        @map("form_data")
  unitPriceCents  Int         @map("unit_price_cents")
  totalPriceCents Int         @map("total_price_cents")

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer   ServiceOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([offerId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @map("booking_id") @db.Uuid
  fromStatus BookingStatus?   @map("from_status")
  toStatus   BookingStatus    @map("to_status")
  actorType  BookingActorType @map("actor_type")
  actorId    String?          @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime         @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model BookingPhoto {
  id         String               @id @default(uuid()) @db.Uuid
  bookingId  String               @map("booking_id") @db.Uuid
  uploadedBy BookingPhotoUploader @map("uploaded_by")
  photoType  BookingPhotoType     @map("photo_type")
  fileUrl    String               @map("file_url") @db.VarChar(500)
  createdAt  DateTime             @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, photoType])
  @@map("booking_photos")
}

model BookingBroadcast {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  score      Decimal  @db.Decimal(8, 2)
  rank       Int
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId])
  @@index([providerId, createdAt])
  @@map("booking_broadcasts")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @unique @map("booking_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  amountCents           Int           @map("amount_cents")
  commissionCents       Int           @map("commission_cents")
  providerNetCents      Int           @map("provider_net_cents")
  currency              String        @default("EUR") @db.Char(3)
  status                PaymentStatus
  capturedAt            DateTime?     @map("captured_at")
  refundedAt            DateTime?     @map("refunded_at")
  payoutFrozenAt        DateTime?     @map("payout_frozen_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model StripeEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id") @db.VarChar(255)
  type          String   @map("event_type") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("stripe_events")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  tags       String[] @default([])
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, isHidden])
  @@map("reviews")
}

model Dispute {
  id               String           @id @default(uuid()) @db.Uuid
  bookingId        String           @unique @map("booking_id") @db.Uuid
  openedBy         DisputeOpenedBy  @map("opened_by")
  reason           DisputeReason
  description      String
  status           DisputeStatus    @default(open)
  resolutionNotes  String?          @map("resolution_notes")
  resolvedBy       String?          @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  clientId         String           @map("client_id") @db.Uuid
  providerId       String           @map("provider_id") @db.Uuid

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("disputes")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
