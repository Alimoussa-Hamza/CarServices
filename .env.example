# CARSERVICE — variables d'environnement locales
# Copier vers apps/api/.env et apps/admin/.env.local selon besoin

# API
PORT=3000
DATABASE_URL=postgresql://carservice:carservice@localhost:5434/carservice?schema=public
REDIS_URL=redis://localhost:6380

# Admin
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mobile (client + pro)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Stripe Connect (test mode — laisser vide pour mock local)
# Ne jamais coller les clés dans le chat / le repo. Fichier apps/api/.env uniquement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 / Object storage (Scaleway ou R2 — laisser vide pour mock local)
# Copier vers apps/api/.env uniquement. Ne jamais coller les clés dans le chat / le repo.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Commission plateforme figée au booking (0.20 = 20 %)
PLATFORM_COMMISSION_RATE=0.20

# Matching broadcast (5–10, défaut 8)
MATCHING_BROADCAST_SIZE=8

# Géofence optionnelle à l'arrivée (mètres, RG-BOOK-03)
BOOKING_GEOFENCE_METERS=200

# Matching timeouts T1/T2 (RG-MATCH-04/05)
MATCHING_TIMEOUT_T1_MINUTES=30
MATCHING_TIMEOUT_T2_HOURS=2
MATCHING_UNASSIGNED_LEAD_HOURS=2
MATCHING_RADIUS_EXPAND_FACTOR=2
# MATCHING_WORKER_ENABLED=true
# PAYMENTS_WORKER_ENABLED=true

# Annulation RG-CANCEL
CANCEL_FREE_HOURS=24
CANCEL_LATE_HOURS=2
CANCEL_FEE_MID_PERCENT=20
CANCEL_FEE_LATE_PERCENT=50
