{
  "name": "@carservice/mobile-provider",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8082",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "expo start --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "echo 'lint mobile-provider'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --watchAll=false --forceExit",
    "eas-build-post-install": "pnpm -w --filter @carservice/shared-types build"
  },
  "dependencies": {
    "@carservice/api-client": "workspace:*",
    "@carservice/shared-types": "workspace:*",
    "@carservice/ui-tokens": "workspace:*",
    "@expo/vector-icons": "^14.0.4",
    "expo": "~52.0.46",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.20",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.3"
  }
}
