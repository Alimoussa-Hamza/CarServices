{
  "expo": {
    "name": "CarWash",
    "slug": "carservice-client",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "carservice-client",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D6E4F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.carservice.client",
      "infoPlist": {
        "NSCameraUsageDescription": "CarWash utilise l’appareil photo pour les photos du véhicule.",
        "NSPhotoLibraryUsageDescription": "CarWash accède à la galerie pour les photos du véhicule.",
        "NSLocationWhenInUseUsageDescription": "CarWash utilise votre position pour vérifier la zone de lavage."
      }
    },
    "android": {
      "package": "fr.carservice.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D6E4F"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D6E4F"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.fr.carservice.client",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
